{
  "name": "mgy-store",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Misguided Yutes: Astro storefront with a 3D chain showcase and a WhatsApp checkout",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "validate": "node scripts/validate.mjs",
    "catalog": "node scripts/import-shopify-csv.mjs",
    "images": "node scripts/process-images.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "logo": "node scripts/render-logo.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "^1.65.1"
  }
}
