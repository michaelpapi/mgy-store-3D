---
import { config } from '../lib/site';
const b = config.business;
---
<header>
  <div class="bar">
    <a class="brand" href="/" aria-label={`${b.name} home`}>
      <img class="lg-ink" src="/brand/mgy-logo-ink-sm.webp" alt={b.name} width="98" height="46" />
      <img class="lg-white" src="/brand/mgy-logo-sm.webp" alt="" aria-hidden="true" width="98" height="46" />
      <span class="wm display">{b.wordmark}</span>
    </a>
    <nav id="nav" aria-label="Shop categories">
      <a href="/#lookbook" data-jump="#lookbook">Lookbook</a>
      <a href="/?cat=All#shop" data-filter="All">Shop all</a>
      {config.categories.map((c) => <a href={`/?cat=${encodeURIComponent(c)}#shop`} data-filter={c}>{c}</a>)}
    </nav>
    <div class="act">
      <button id="tg" class="tg" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
        <svg class="moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" class="cart-btn" data-open-cart>Cart (<span data-cart-count>0</span>)</button>
    </div>
  </div>
</header>
